{
	"name": "repo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"analyze": "bun run knip && bun run dupes",
		"dupes": "jscpd .",
		"knip": "knip --include files,dependencies,unlisted,binaries",
		"knip:all": "knip",
		"codegraph": "bun scripts/dev/codegraph.ts",
		"postinstall": "bun run codegraph",
		"lint": "oxlint && oxfmt --check .",
		"format": "oxfmt . && oxlint --fix",
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"build:rust": "cargo build --release -p fatima-cli --bin fatima",
		"build:binaries": "cargo run -p task -- build-binaries",
		"checktypes": "turbo run checktypes",
		"check:rust": "cargo check --workspace",
		"test:rust": "cargo test --workspace",
		"bump": "cargo run -p task -- bump",
		"revert-bump": "cargo run -p task -- revert-bump",
		"commit-release": "cargo run -p task -- commit-release",
		"version": "cargo run -p task -- set-version",
		"verify:release": "cargo run -p task -- verify-release",
		"publish:npm": "turbo run build:prebuilt --filter=@fatima.dev/js && npm publish packages/js --access public --provenance",
		"publish:crates": "cargo publish -p fatima-core && cargo publish -p fatima-cli"
	},
	"devDependencies": {
		"jscpd": "^5.0.16",
		"knip": "^6.32.2",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"turbo": "^2.6.1",
		"typescript": "6.0.3"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0",
	"trustedDependencies": [
		"esbuild",
		"sharp"
	]
}
